{
  "name": "rust-auth-example",
  "version": "0.0.0",
  "description": "The public, production-shaped reference app for bymax-auth / @bymax-one/rust-auth.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Bymax One",
    "url": "https://bymax.one"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bymaxone/rust-auth-example.git"
  },
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.8"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "pnpm -r --if-present run test:cov",
    "prepare": "husky",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v",
    "//": "db:migrate requires a live DATABASE_URL (export from .env after pnpm infra:up). The DATABASE_URL in .cargo/config.toml is a compile-time offline placeholder only.",
    "db:migrate": "sqlx migrate run --source apps/api/migrations",
    "db:prepare": "pnpm db:migrate && cargo sqlx prepare --workspace -- --all-targets",
    "audit:exports": "node scripts/audit-library-exports.mjs --report",
    "audit:public-api": "bash scripts/audit-rust-public-api.sh",
    "check:public-api": "node scripts/check-public-api-usage.mjs --report"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  }
}

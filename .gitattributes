# Normalize line endings to LF on checkin for text files; let Git detect binary.
* text=auto eol=lf

# Explicitly binary assets (never diffed or line-ending-normalized).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.wasm binary

# Generated lockfiles: collapse in diffs and mark as generated in reviews.
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true -diff

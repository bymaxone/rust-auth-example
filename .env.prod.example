# ---------------------------------------------------------------------------
# Production environment template -- copy to .env.prod and fill in real values.
# NEVER commit .env.prod to version control.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # generate and fill in all secrets below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Docker Compose / Postgres (prod -- use a managed database in real prod)
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=example_app_prod

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=4000
# WEB_ORIGIN must be https:// in production (deployment requirement).
WEB_ORIGIN=https://
# DATABASE_URL must point at a managed Postgres service (no loopback).
DATABASE_URL=
# REDIS_URL must point at a managed Redis service (no loopback).
REDIS_URL=
REDIS_NAMESPACE=rust_auth_example

# ---------------------------------------------------------------------------
# JWT / MFA -- GENERATE fresh values; never reuse the dev placeholders.
# ---------------------------------------------------------------------------
# openssl rand -hex 64
JWT_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
SMTP_FROM=no-reply@yourdomain.com
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# OAuth -- Google (optional)
# ---------------------------------------------------------------------------
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/oauth/google/callback

# ---------------------------------------------------------------------------
# Redis password (for docker-compose.prod.yml requirepass)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://
INTERNAL_API_URL=http://api:4000
# AUTH_JWT_SECRET_FOR_PROXY must equal JWT_SECRET exactly.
AUTH_JWT_SECRET_FOR_PROXY=
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false

# ---------------------------------------------------------------------------
# Image tag (set by release workflow; override for manual deploys)
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
